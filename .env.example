# Copy to .env and fill in, then:  set -a; source .env; set +a

# Fine-grained personal access token scoped to your demo organisation.
# Setup script needs:  Administration (write), Contents (write)
# Analyzer needs only: Contents (read), Dependabot alerts (read), Metadata (read)
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx

# Your demonstration organisation login, exactly as it appears in the URL.
GITHUB_ORG=sbom-analyzer-demo

# SQLite is the default and is sufficient. For PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/sbom_c2
DATABASE_URL=sqlite:///./sbom_c2.db
